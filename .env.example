# Copia questo file in .env (ignorato da git) e riempi i valori. Mai committare il .env.
# Le chiavi seguono la configurazione .NET: i due trattini bassi separano le sezioni.

# Primo giorno dello storico da ricostruire
Sync__StartDate=2026-01-01

# Zona di mercato e regime GSE (RidZonale | RidPmg)
Valuation__Zone=NORD
Valuation__Regime=RidZonale

# GME: credenziali del servizio API (la password scade ogni 6 mesi)
Gme__UserName=<segreto>
Gme__Password=<segreto>

# FusionSolar Northbound
Energy__Provider=FusionSolar
Energy__FusionSolar__BaseUrl=https://<prefisso>.fusionsolar.huawei.com/thirdData/
Energy__FusionSolar__UserName=<segreto>
Energy__FusionSolar__SystemCode=<segreto>
Energy__FusionSolar__StationCode=<da ricavare al primo login>
