server {
  listen 80;
  root /usr/share/nginx/html;

  # L'API sta in un altro container; il browser parla solo con questo.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_read_timeout 600s; # l'avvio manuale di un job può durare minuti
  }

  # File con hash nel nome: si tengono in cache a lungo.
  location ~* \.(js|css|woff2?|png|svg|ico)$ {
    expires 30d;
    try_files $uri =404;
  }

  # Applicazione a pagina singola: ogni altra rotta è index.html.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
