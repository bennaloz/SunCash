<Project>
  <!-- Impostazioni comuni a tutti i progetti. Niente PackageReference qui:
       finirebbero anche in SunCash.Domain, che non deve avere dipendenze. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
